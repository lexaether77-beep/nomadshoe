// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

enum Currency {
  USD
  NGN
}

model Order {
  id        String      @id @default(cuid())
  reference String      @unique
  status    OrderStatus @default(PENDING)
  currency  Currency
  amount    Decimal     @db.Decimal(10, 2)

  fullName     String
  email        String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String?
  country      String

  flutterwaveTxId String?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  items    OrderItem[]
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  colorwaySlug String
  size         String
  quantity     Int
  unitPriceUSD Int
}

enum MessageKind {
  CUSTOM
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
}

model Message {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  kind      MessageKind
  toEmail   String
  subject   String
  body      String
  delivered Boolean @default(false)

  sentAt DateTime @default(now())

  @@index([toEmail])
}

model DiscountCode {
  id        String   @id @default(cuid())
  code      String   @unique
  priceUSD  Int
  maxUses   Int
  usedCount Int      @default(0)

  createdAt DateTime @default(now())
}

model WaitlistEntry {
  id                String    @id @default(cuid())
  email             String    @unique
  source            String?
  unsubscribeToken  String    @unique @default(cuid())
  unsubscribedAt    DateTime?

  welcomeEmailSentAt   DateTime?
  progressEmailSentAt  DateTime?
  launchEmailSentAt    DateTime?

  createdAt DateTime @default(now())
}
