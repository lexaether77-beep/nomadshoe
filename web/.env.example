# Database (Vercel Postgres / Neon)
DATABASE_URL=
# Only needed locally when running `prisma migrate dev` (e.g. via `npx prisma dev`)
SHADOW_DATABASE_URL=

# Flutterwave (https://dashboard.flutterwave.com/settings/apis)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Resend (order confirmation emails)
RESEND_API_KEY=

# Public site URL, used for Flutterwave redirect_url
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# /admin (HTTP Basic Auth) — pick your own values
ADMIN_USER=
ADMIN_PASSWORD=
